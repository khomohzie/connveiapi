# App
NODE_ENV=
APP_NAME=
PORT=
CLIENT_URL=

# Database
DATABASE=
DATABASE_CLOUD=

# JWT
JWT_SECRET=
JWT_ACCOUNT_ACTIVATION=
JWT_RESET_PASSWORD=

# Google login
GOOGLE_CLIENT_ID=

# Contact form recipients
EMAIL_TO=
EMAIL_FROM=

# CLOUDINARY
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_URL=

# GMAIL API (OAuth2) - sends over HTTPS so it works where SMTP ports are blocked.
# Enable the Gmail API in Google Cloud Console and generate a refresh token.
MAIL_USERNAME=           # the sending Gmail address (also the default From)
MAIL_PASSWORD=           # legacy / unused by the Gmail API transport
OAUTH_CLIENTID=          # OAuth2 client id (OAUTH_CLIENT_ID is also accepted)
OAUTH_CLIENT_SECRET=
OAUTH_REFRESH_TOKEN=
OAUTH_EMAIL=             # optional: overrides the From address (defaults to MAIL_USERNAME)
