{
  "ts-node": {
    "files": true
  },
  "compilerOptions": {
    "target": "es2019",
    "module": "commonjs",
    "outDir": "./dist",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": false
  },
  "include": ["src/**/*.ts", "environment.d.ts"],
  "exclude": ["node_modules", "dist"]
}
